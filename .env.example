# ============================================
# فهم‌یار (Fahmyar) — نمونهٔ فایل تنظیمات
# این فایل را به .env کپی کنید و مقادیر را وارد کنید:
#   cp .env.example .env
# ============================================

# پروایدر هوش مصنوعی:
#   gemini_free → گوگل جمینی ۲ فلش (پلن رایگان، نیازمند کلید از https://ai.google.dev)
#   mock        → بدون کلید و کاملاً آفلاین (برای تست و توسعه)
AI_PROVIDER=gemini_free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# حداقل فاصلهٔ بین فراخوانی‌های Gemini (ثانیه) — محدودیت نرخ پلن رایگان (~۱۵ RPM)
GEMINI_MIN_INTERVAL_SECONDS=4.0
#   openrouter  → مدل‌های OpenRouter (AI_PROVIDER=openrouter)؛ فراخوانی HTTP محض با requests
# توجه: «خطای 401 — User not found» یعنی کلید نامعتبر است؛ کلید با .strip() خوانده می‌شود (فاصلهٔ انتهایی علت رایج 401 است)
OPENROUTER_API_KEY=
# مدل: شناسهٔ صریح، یا «auto» برای انتخاب خودکار بهترین مدل رایگان لحظه‌ای
# (لیست هر ۱۵ دقیقه کش می‌شود؛ در صورت خطای 404/400/پولی‌شدن، به‌صورت خودکار به مدل بعدی می‌رود)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# فاصله‌گذاری ملایم بین فراخوانی‌ها (ثانیه) — پیش‌فرض ۱.۰
OPENROUTER_MIN_INTERVAL_SECONDS=1.0
# اختیاری: شناساندن برنامه به OpenRouter (هدرهای HTTP-Referer و X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Fahmyar App
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

# پایگاه داده (پیش‌فرض: فایل SQLite کنار کد)
DATABASE_URL=sqlite:///./fahmyar.db

# امنیت — در محیط واقعی حتماً تغییر دهید
JWT_SECRET=fahmyar-dev-secret-change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# بودجهٔ کل هزینهٔ هوش مصنوعی به دلار (پلن رایگان همیشه صفر است)
BUDGET_LIMIT_USD=10.0

# محدودیت زمانی جلسهٔ ارزیابی (ثانیه) — پیش‌فرض ۳۰ دقیقه
SESSION_TIME_LIMIT_SECONDS=1800
MAX_SESSION_QUESTIONS=12

# اگر اطمینان تحلیل‌گر پاسخ کمتر از این مقدار بود → «نامشخص» + بررسی معلم
CONFIDENCE_THRESHOLD=0.6
